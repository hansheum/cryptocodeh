\else
    \edef\JetBrainsMono@@scale{s*[\csname JetBrainsMono@scale\endcsname]}%
\fi

\DeclareFontFamily{T1}{JetBrainsMono-TLF}{\hyphenchar\font=-1}


%   ----  m = regular  ----

\DeclareFontShape{T1}{JetBrainsMono-TLF}{m}{n}{
      <-> \JetBrainsMono@@scale JetBrainsMono-Regular-tlf-t1
}{}

